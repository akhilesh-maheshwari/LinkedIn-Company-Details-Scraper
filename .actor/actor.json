{
  "actorSpecification": 1,
  "name": "linkedin-company-details-scraper-no-cookies",
  "title": "LinkedIn Company Details Scraper (No Cookies)",
  "description": "Scrape LinkedIn company details including name, industry, employee count, website, headquarters, founded year, and more. No LinkedIn cookies required.",
  "version": "1.0",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "LinkedIn Company Details Output",
    "description": "Scraped LinkedIn company data including name, industry, employee count, website, headquarters, founded year, locations, logo, and more.",
    "properties": {
      "results": {
        "type": "string",
        "title": "LinkedIn Companies",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "input_url",
              "normalized_url",
              "correct_url",
              "data_status",
              "url_status",
              "url_source",
              "company_id",
              "company_slug",
              "name",
              "slogan",
              "about",
              "specialties",
              "industries",
              "organization_type",
              "company_size",
              "type",
              "sphere",
              "website",
              "website_simplified",
              "company_url",
              "crunchbase_url",
              "headquarters",
              "country_code",
              "followers",
              "employees_in_linkedin",
              "founded",
              "locations",
              "formatted_locations",
              "description",
              "logo",
              "image",
              "is_school",
              "request_id",
              "child_request_id",
              "order_id",
              "processed_at"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  }
}
